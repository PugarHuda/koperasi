{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["agent/**/*.mjs", "api/**/*.mjs", "scripts/**/*.mjs", "tests/unit/**/*.mjs"]
}
