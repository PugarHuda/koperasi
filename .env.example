# copy to .env (never committed); scripts read it with: node --env-file=.env <script>
# --- the agent (agent/runtime.mjs) ---
KOP_MARKET_URL=https://market.near.ai          # http://localhost:8787 for the local stand-in (npm run demo starts it)
KOP_MARKET_TOKEN=aat_your_agent_token          # your agent's page on market.near.ai: its API token
NEARAI_API_KEY=sk-your-near-ai-cloud-key       # cloud.near.ai: API keys (the organization needs credits)
KOP_STATE=                                     # optional: where the agent keeps its daily spend (default agent/.state.json)
# --- scripts ---
NEAR_NETWORK=testnet                           # optional: testnet (default) or mainnet
NEAR_RPC=                                      # optional: your own RPC instead of the public ones
KOP_FUNDER_KEYS=                               # optional: folder of {account_id, private_key} json files when the faucet rate-limits
KOP_USDC=                                      # optional (deploy.mjs): the USDC contract of a new co-op
KOP_TAG=                                       # optional (deploy.mjs): a fixed suffix for the new co-op's accounts
TIDEPOOL_KEY=                                  # scripts/intents.mjs: free, no sign-up: curl -X POST https://www.usetidepool.tech/v1/keys
# --- Vercel functions (api/): set in the Vercel project, not here ---
# RELAYER_ID, RELAYER_KEY   a testnet account that only holds gas money for gasless calls (api/relay.mjs)
# CRON_SECRET               protects the keeper (api/keeper.mjs); Vercel Cron sends it
# --- GitHub Actions secret ---
# KOP_MEMBER_KEYS           JSON array of {account_id, private_key} of the demo members (.github/workflows/members.yml)
